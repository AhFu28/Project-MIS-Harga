{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-mis-harga",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mis-harga-db"
    }
  ],
  "vars": {
    "GEMINI_FREE_CONFIRMED": "false"
  },
  "observability": {
    "enabled": false
  }
}
